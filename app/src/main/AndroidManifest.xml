<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LSPosed 模块：无需 Activity，仅声明模块元数据 -->
    <application
        android:allowBackup="true"
        android:label="DouyinSDR"
        android:hasCode="true">

        <!-- LSPosed 模块三要素 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="只针对抖音强制SDR，屏蔽HDR峰值亮度；其他APP保持系统原生HDR。" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />

        <!-- 模块作用域预填：抖音 + 系统框架 -->
        <meta-data
            android:name="xposedscope"
            android:value="com.ss.android.ugc.aweme, android" />
    </application>
</manifest>
